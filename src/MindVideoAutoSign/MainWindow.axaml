<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MindVideoAutoSign.MainWindow"
        Title="MindVideo Flow v1.0.0"
        Width="1000" Height="860"
        MinWidth="1000" MinHeight="860"
        Background="#F4F7FB">
  <Window.Styles>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="24" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#65758B" />
    </Style>
    <Style Selector="Button.nav">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#BED5EB" />
      <Setter Property="Padding" Value="13,10" />
      <Setter Property="CornerRadius" Value="7" />
    </Style>
    <Style Selector="Button.nav:pointerover">
      <Setter Property="Background" Value="#203B5C" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#1976D2" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Padding" Value="17,10" />
    </Style>
    <Style Selector="Button.success">
      <Setter Property="Background" Value="#0F766E" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Padding" Value="17,10" />
    </Style>
  </Window.Styles>

  <Grid ColumnDefinitions="244,*">
    <!-- Sidebar -->
    <Border Background="#102A43" Padding="25">
      <StackPanel Spacing="20">
        <StackPanel Spacing="6">
          <TextBlock Text="MindVideo Flow" FontSize="24" FontWeight="Bold" Foreground="White" />
          <TextBlock Text="v1.0.0" FontSize="12" Foreground="#A9D2D0" Margin="0,-4,0,0" />
          <TextBlock Text="自動簽到控制台" Foreground="#A9CCE8" />
          <TextBlock Text="管理 Token、GitHub Actions 與每日簽到結果。"
                     TextWrapping="Wrap" FontSize="12" Foreground="#8FB9DB" Margin="0,8,0,0" />
        </StackPanel>

        <Border Background="#193958" CornerRadius="10" Padding="14">
          <StackPanel Spacing="6">
            <TextBlock Text="安全提醒" FontWeight="SemiBold" Foreground="White" />
            <TextBlock Text="登入與驗證必須由你在瀏覽器中完成。此工具只會擷取或保存 Bearer Token，不會把 Token 寫回專案檔。"
                       TextWrapping="Wrap" FontSize="12" Foreground="#BED5EB" />
          </StackPanel>
        </Border>

        <StackPanel Spacing="5">
          <Button Classes="nav" Click="DashboardNavButton_OnClick">簽到總覽</Button>
          <Button Classes="nav" Click="AccountsNavButton_OnClick">帳號設定</Button>
          <Button Classes="nav" Click="LoginNavButton_OnClick">更新登入狀態</Button>
        </StackPanel>

        <TextBlock Text="排程：台灣時間 05、11、17、23 時；每次依帳號錯開啟動。"
                   TextWrapping="Wrap" FontSize="12" Foreground="#8FB9DB" Margin="0,18,0,0" />
      </StackPanel>
    </Border>

    <!-- Content -->
    <ScrollViewer Grid.Column="1" Margin="38,34,24,24" HorizontalScrollBarVisibility="Disabled">
      <StackPanel MaxWidth="650" Spacing="18">

        <!-- Dashboard -->
        <StackPanel x:Name="DashboardView" Spacing="18">
          <TextBlock Text="簽到總覽" FontSize="30" FontWeight="SemiBold" Foreground="#132A42" />
          <TextBlock Classes="muted"
                     Text="手動執行每日簽到，並讀取最近一次 MindVideo Daily Check-in 的完成狀態與連續簽到天數。"
                     TextWrapping="Wrap" />

          <Border Classes="panel">
            <StackPanel Spacing="18">
              <TextBlock Text="GitHub Actions 儀表板" FontSize="20" FontWeight="SemiBold" />
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="TriggerButton" Classes="primary" Click="TriggerButton_OnClick">立即執行簽到</Button>
                <Button x:Name="RefreshButton" Click="RefreshButton_OnClick">更新執行結果</Button>
              </StackPanel>

              <Grid ColumnDefinitions="*,*">
                <StackPanel Spacing="4" Margin="0,0,12,0">
                  <TextBlock Classes="muted" Text="已設定帳號" FontSize="12" />
                  <TextBlock x:Name="ConfiguredMetric" Text="—" FontSize="20" FontWeight="SemiBold" Foreground="#0F766E" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4" Margin="12,0,0,0">
                  <TextBlock Classes="muted" Text="最近執行" FontSize="12" />
                  <TextBlock x:Name="RunMetric" Text="尚未讀取" FontSize="20" FontWeight="SemiBold" />
                </StackPanel>
              </Grid>

              <Border Height="1" Background="#DCE5EF" />

              <Grid ColumnDefinitions="*,*">
                <StackPanel Spacing="4" Margin="0,0,12,0">
                  <TextBlock Classes="muted" Text="連續簽到摘要" FontSize="12" />
                  <TextBlock x:Name="StreakMetric" Text="—" FontSize="18" FontWeight="SemiBold" Foreground="#0F766E" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4" Margin="12,0,0,0">
                  <TextBlock Classes="muted" Text="完成時間" FontSize="12" />
                  <TextBlock x:Name="RunTimeMetric" Text="—" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>
              </Grid>

              <TextBlock x:Name="DashboardStatus" Classes="muted"
                         Text="執行後可在 GitHub Actions 檢視各帳號的成功、失敗與未設定狀態。"
                         TextWrapping="Wrap" />

              <TextBlock Text="帳號簽到明細" FontSize="16" FontWeight="SemiBold" />
              <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="AccountsPanel" Spacing="7" />
              </ScrollViewer>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Account aliases -->
        <StackPanel x:Name="AccountsView" IsVisible="False" Spacing="18">
          <TextBlock Text="帳號設定" FontSize="30" FontWeight="SemiBold" Foreground="#132A42" />
          <TextBlock Classes="muted"
                     Text="名稱只保存在本機，用於讓 33 個 GitHub Secret（MINDVIDEO_TOKEN1…33）更容易辨識。"
                     TextWrapping="Wrap" />
          <Border Classes="panel">
            <StackPanel Spacing="12">
              <TextBlock Text="帳號別名" FontSize="19" FontWeight="SemiBold" />
              <ScrollViewer MaxHeight="410">
                <StackPanel x:Name="AliasPanel" Spacing="8" />
              </ScrollViewer>
              <Button HorizontalAlignment="Left" Click="SaveAliasesButton_OnClick">儲存本機別名</Button>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Token / login update -->
        <StackPanel x:Name="LoginView" IsVisible="False" Spacing="18">
          <TextBlock Text="更新登入狀態" FontSize="30" FontWeight="SemiBold" Foreground="#132A42" />
          <TextBlock Classes="muted"
                     Text="Chrome：CDP 必須用獨立 user-data-dir（不可用系統 Chrome\User Data）。Firefox：Playwright persistent profile（建議獨立資料夾；可指定本機 Firefox profile，但需先關閉 Firefox）。首次 Google 登入後 cookie 會留在專用資料夾。維持 ≥5 秒後擷取 Token。"
                     TextWrapping="Wrap" />

          <Border Classes="panel">
            <StackPanel Spacing="14">
              <TextBlock Text="選擇帳號" FontSize="19" FontWeight="SemiBold" />
              <ComboBox x:Name="AccountComboBox" Width="260" SelectedIndex="0"
                        SelectionChanged="AccountComboBox_OnSelectionChanged" />

              <Border Background="#E8F1FB" CornerRadius="7" Padding="12,8">
                <TextBlock x:Name="SecretNameText" FontFamily="Consolas" Foreground="#125799" />
              </Border>

              <TextBlock x:Name="BrowserSettingsTitle" Text="瀏覽器啟動設定" FontSize="16" FontWeight="SemiBold" />
              <TextBlock Classes="muted" Text="瀏覽器引擎" FontSize="12" />
              <ComboBox x:Name="BrowserEngineComboBox" Width="220" SelectedIndex="0"
                        HorizontalAlignment="Left"
                        SelectionChanged="BrowserEngineComboBox_OnSelectionChanged">
                <ComboBoxItem Content="Chrome / Edge（CDP）" Tag="chrome" />
                <ComboBoxItem Content="Firefox（Playwright）" Tag="firefox" />
              </ComboBox>
              <TextBlock x:Name="ChromeExeLabel" Classes="muted" Text="瀏覽器執行檔（chrome.exe / firefox.exe）" FontSize="12" />
              <TextBox x:Name="ChromeExeBox"
                       Watermark="C:\Program Files\Google\Chrome\Application\chrome.exe"
                       LostFocus="ChromeSettings_OnLostFocus" />
              <TextBlock x:Name="ChromeUserDataLabel" Classes="muted" Text="設定檔資料夾（Chrome=user-data-dir / Firefox=profile）" FontSize="12" />
              <TextBox x:Name="ChromeUserDataBox"
                       Watermark="%LOCALAPPDATA%\MindVideo Auto Sign\chrome-cdp\account-01"
                       LostFocus="ChromeSettings_OnLostFocus" />
              <TextBlock x:Name="ChromeProfileDirLabel" Classes="muted" Text="備註（選填：系統 Profile 名稱或說明）" FontSize="12" />
              <TextBox x:Name="ChromeProfileDirBox"
                       Watermark="例如 Profile 2 / hVesXz80.設定檔 2（僅備註）"
                       Width="360"
                       HorizontalAlignment="Left"
                       LostFocus="ChromeSettings_OnLostFocus" />
              <TextBlock Classes="muted" Text="實際啟動指令預覽" FontSize="12" />
              <Border Background="#F7F9FA" CornerRadius="7" Padding="12,8">
                <TextBlock x:Name="ChromeCommandPreview"
                           FontFamily="Consolas"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="#334155" />
              </Border>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="SaveChromeProfileButton" Click="SaveChromeProfileButton_OnClick">儲存此帳號瀏覽器設定</Button>
                <Button x:Name="ResetChromeProfileButton" Click="ResetChromeProfileButton_OnClick">還原 Chrome 預設</Button>
                <Button x:Name="ResetFirefoxProfileButton" Click="ResetFirefoxProfileButton_OnClick">還原 Firefox 預設</Button>
              </StackPanel>

              <Border Height="1" Background="#DCE5EF" Margin="0,4" />

              <TextBlock Classes="muted" Text="MindVideo Token（密碼顯示）" FontSize="12" />
              <TextBox x:Name="TokenBox" PasswordChar="•" Watermark="貼上或由瀏覽器擷取後會顯示在這裡" />

              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="StartLoginButton" Classes="primary" Click="StartLoginButton_OnClick">Google 登入並擷取 Token</Button>
                <Button x:Name="CopyTokenButton" IsEnabled="False" Click="CopyTokenButton_OnClick">複製 Token</Button>
                <Button x:Name="CopySecretButton" Click="CopySecretButton_OnClick">複製 Secret 名稱</Button>
              </StackPanel>

              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="SaveLocalButton" Click="SaveLocalButton_OnClick">儲存本機 Token</Button>
                <Button x:Name="PushSecretButton" Classes="success" Click="PushSecretButton_OnClick">更新到 GitHub Secret</Button>
              </StackPanel>

              <Border Height="1" Background="#DCE5EF" Margin="0,4" />

              <TextBlock Text="目前帳號狀態" FontSize="16" FontWeight="SemiBold" />
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="ReadStatusButton" Click="ReadStatusButton_OnClick">讀取狀態</Button>
                <Button x:Name="LocalCheckInButton" Click="LocalCheckInButton_OnClick">直接簽到</Button>
              </StackPanel>
              <TextBlock x:Name="PointsStatus" Classes="muted"
                         Text="需要先設定此帳號的 Token。"
                         TextWrapping="Wrap" />
              <TextBlock x:Name="LoginStatus" Classes="muted"
                         Text="擷取後，可將 Token 更新到對應的 GitHub Actions Secret，或僅保存在本機。"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
